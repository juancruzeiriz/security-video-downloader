# ============================================================================
# Variables sensibles / parametrizables del lab. Copia este archivo a .env
# (que esta gitignoreado) y completa los valores. .env se carga solo.
# ============================================================================

# Clave secreta HMAC. La comparten SOLO tu backend y la CDN/origen.
# Generala larga y aleatoria, p.ej.:  python -c "import secrets;print(secrets.token_hex(32))"
# Usada por el origen-fixture (para verificar) y por `python -m svd.tokens sign`.
SVD_SECRET=pon-una-clave-larga-y-aleatoria-aca

# Host del origen al que le pega el descargador.
# Default local; cuando pruebes contra TU server publicado, cambialo aca.
SVD_BASE_URL=http://localhost:8000

# Token firmado exp=..~acl=..~hmac=.. (lo generas vos, ver README).
# Podes dejarlo vacio y pasarlo por --token en cada corrida.
SVD_TOKEN=

# User-Agent que envia el descargador / la telemetria.
SVD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36

# Ruta del endpoint de telemetria del reproductor.
SVD_EVENT_PATH=/video-diagnostic/event

# --- Solo para el origen-fixture local ---
# Carpeta raiz donde se genera/sirve el HLS.
SVD_MEDIA_ROOT=media/hls
# Prefijo de rutas que exigen token (todo, por default).
SVD_PROTECTED_PREFIX=/

# ============================================================================
# Etapa 2: defensas del origen (opt-in). Con SVD_DEFENSE=1 el origen aplica
# rate limiting, pacing, binding multi-IP, limite de sesiones y gate de playback.
# Sin esta variable, se comporta como en la Etapa 1 (solo firma/exp/acl).
# ============================================================================
SVD_DEFENSE=0
# Sesiones activas simultaneas permitidas.
SVD_MAX_SESSIONS=3
# Rate limit por sesion: pedidos por ventana.
SVD_RATE_MAX=120
SVD_RATE_WINDOW=60
# IPs distintas permitidas por sesion (1 = el token no se puede compartir).
SVD_MAX_IPS=1
# Pacing: duracion nominal del segmento y cuantos se permiten "adelantados".
SVD_SEGMENT_DURATION=2
SVD_BURST_ALLOWANCE=3
# Exigir un evento de telemetria playback_started antes de servir segmentos.
SVD_REQUIRE_PLAYBACK=0
# Segundos para considerar una sesion "activa" (para el conteo de concurrencia).
SVD_SESSION_TTL=300

# --- Rotacion de clave ---
# Durante una rotacion, la clave anterior sigue validando tokens ya emitidos.
# SVD_SECRET_PREVIOUS=clave-anterior-durante-la-rotacion

# --- Renovacion de tokens cortos ---
# TTL (segundos) del token que emite POST /token/renew.
SVD_RENEW_TTL=120

# --- Solo lab / tests ---
# Confiar en X-Forwarded-For para simular IPs de cliente (NO usar en produccion).
SVD_TRUST_XFF=0
# Exponer GET /debug/defense con el estado del motor de defensa.
SVD_DEBUG=0
